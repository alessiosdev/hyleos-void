# Ricetta xbps-src — hyleos-installer
pkgname=hyleos-installer
version=1.0.0
revision=5
short_desc="HyleOS - installer grafico (GTK4) per UEFI x86_64"
maintainer="Hyle OS Team"
license="MIT"
homepage="https://github.com/alessiosdev/hyleos-void"

depends="
  python3
  python3-gobject
  gtk4
  polkit
  parted
  gptfdisk
  psmisc
  rsync
  dosfstools
  efibootmgr
  grub-x86_64-efi
"

do_install() {
    vinstall ${FILESDIR}/bin/hyleos-installer 755 usr/bin
    # vcopy usa cp -a: la directory di destinazione va creata prima.
    vmkdir usr/share/hyleos
    vinstall ${FILESDIR}/share/hyleos/installer.py 644 usr/share/hyleos
    vcopy ${FILESDIR}/share/hyleos/installer usr/share/hyleos
    vinstall ${FILESDIR}/applications/org.hyleos.installer.desktop 644 usr/share/applications
    vinstall ${FILESDIR}/polkit/org.hyleos.installer.policy 644 usr/share/polkit-1/actions
    vinstall ${FILESDIR}/polkit/50-hyleos-installer-live.rules 644 usr/share/polkit-1/rules.d
}
