#!/bin/sh
# Start the HyleOS DMS (DankMaterialShell / Quickshell) session.
#
# DMS v1.6.x e' solo il backend: la UI viene lanciata come processo separato
# `qs` (quickshell). Se quickshell manca, `dms run` resta vivo in background
# (notifiche comprese) ma non mostra alcuna shell: per questo controlliamo
# esplicitamente la presenza della UI e logghiamo tutto.
set -u

LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/hyleos"
mkdir -p "$LOG_DIR"
LOG="$LOG_DIR/dms-start.log"

# Ruota il log per non farlo crescere all'infinito.
if [ -f "$LOG" ] && [ "$(wc -c <"$LOG" 2>/dev/null || echo 0)" -gt 262144 ]; then
  mv -f "$LOG" "$LOG.1" 2>/dev/null || true
fi

log() {
  printf '%s %s\n' "$(date -Is 2>/dev/null || date)" "$*" >>"$LOG" 2>&1
}

export PATH="/usr/bin:/bin:${PATH:-}"
export DMS_SHELL_DIR="${DMS_SHELL_DIR:-/etc/xdg/quickshell/hyleos-dms}"

if [ -z "${XDG_RUNTIME_DIR:-}" ] && [ -d "/run/user/$(id -u)" ]; then
  export XDG_RUNTIME_DIR="/run/user/$(id -u)"
fi

log "=== hyleos-dms-start ==="
log "USER=$(id -un) UID=$(id -u)"
log "XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-}"
log "WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-}"
log "HYPRLAND_INSTANCE_SIGNATURE=${HYPRLAND_INSTANCE_SIGNATURE:-}"
log "DMS_SHELL_DIR=$DMS_SHELL_DIR"
log "PATH=$PATH"
log "dms=$(command -v dms || echo MISSING)"
log "quickshell=$(command -v quickshell || echo MISSING)"
log "qs=$(command -v qs || echo MISSING)"
[ -f "$DMS_SHELL_DIR/shell.qml" ] && log "shell.qml=OK" || log "shell.qml=MISSING"

if [ ! -f "$DMS_SHELL_DIR/shell.qml" ]; then
  log "FATAL: $DMS_SHELL_DIR/shell.qml non trovato"
  exit 1
fi

# Attende che il compositor abbia creato il socket Wayland.
i=0
while [ -z "${WAYLAND_DISPLAY:-}" ] && [ "$i" -lt 50 ]; do
  sleep 0.2
  i=$((i+1))
done
log "WAYLAND_DISPLAY(after wait)=${WAYLAND_DISPLAY:-}"

# Quickshell e' indispensabile per la UI. `qs` e' un symlink a quickshell.
QS_BIN=""
if command -v quickshell >/dev/null 2>&1; then
  QS_BIN="quickshell"
elif command -v qs >/dev/null 2>&1; then
  QS_BIN="qs"
fi

if [ -z "$QS_BIN" ]; then
  log "FATAL: quickshell/qs non installato: la shell DMS non puo' partire."
  log "Suggerimento: xbps-install -S quickshell"
  command -v notify-send >/dev/null 2>&1 && \
    notify-send -u critical "Hyle OS" "Quickshell non installato: esegui 'sudo xbps-install -S quickshell'" 2>/dev/null || true
  exit 1
fi

log "UI binary: $QS_BIN"

# La UI e' pronta se esiste un processo quickshell/qs collegato alla nostra
# shell. `qs` e' un symlink: a seconda di come viene invocato il nome del
# processo puo' essere "qs" oppure "quickshell", quindi controlliamo entrambi.
ui_running() {
  pgrep -x quickshell >/dev/null 2>&1 && return 0
  pgrep -x qs >/dev/null 2>&1 && return 0
  pgrep -f "quickshell -p $DMS_SHELL_DIR" >/dev/null 2>&1 && return 0
  pgrep -f "qs -p $DMS_SHELL_DIR" >/dev/null 2>&1 && return 0
  return 1
}

if ! command -v dms >/dev/null 2>&1; then
  log "dms non trovato: avvio direttamente $QS_BIN"
  exec "$QS_BIN" -p "$DMS_SHELL_DIR" >>"$LOG" 2>&1
fi

# DMS backend in foreground (senza --session: su runit non c'e' systemd).
log "avvio: dms run -c $DMS_SHELL_DIR"
dms run -c "$DMS_SHELL_DIR" >>"$LOG" 2>&1 &
DMS_PID=$!
log "dms PID=$DMS_PID"

# Attende fino a 20s che DMS lanci la UI quickshell.
ui_ok=0
i=0
while [ "$i" -lt 100 ]; do
  if ui_running; then
    ui_ok=1
    break
  fi
  if ! kill -0 "$DMS_PID" 2>/dev/null; then
    log "dms e' terminato prima di avviare la UI"
    break
  fi
  sleep 0.2
  i=$((i+1))
done

if [ "$ui_ok" -eq 1 ]; then
  log "UI quickshell rilevata (PID: $( { pgrep -x quickshell; pgrep -x qs; } 2>/dev/null | tr '\n' ' '))"
else
  log "WARN: nessuna UI quickshell dopo 20s; avvio $QS_BIN -p in parallelo al backend"
  command -v notify-send >/dev/null 2>&1 && \
    notify-send -u normal "Hyle OS" "Avvio di emergenza della shell DMS..." 2>/dev/null || true
  "$QS_BIN" -p "$DMS_SHELL_DIR" >>"$LOG" 2>&1 &
  QS_PID=$!
  log "quickshell PID=$QS_PID"
fi

# Resta in vita finche' il backend DMS e' attivo.
wait "$DMS_PID"
rc=$?
log "dms terminato (rc=$rc)"
exit "$rc"
