// Solo nella ISO live l'utente "anon" avvia l'installer senza password: non
// serve che la sessione risulti attiva, perche' nella live puo' non esserlo.
// Dopo l'installazione l'installer rimuove l'utente "anon": la regola resta
// inerte sul sistema installato, dove valgono i defaults auth_admin.
polkit.addRule(function(action, subject) {
    if (action.id == "org.hyleos.installer.launch" &&
        subject.user == "anon" &&
        subject.local) {
        return polkit.Result.YES;
    }
    return polkit.Result.NOT_HANDLED;
});
