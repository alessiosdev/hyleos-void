<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>HyleOS</vendor>
  <vendor_url>https://hyleos.org</vendor_url>

  <!-- hyleos-system-update parte anche da DMS, senza TTY: pkexec usa questa
       azione e l'agente polkit del desktop mostra la richiesta di password. -->
  <action id="org.hyleos.update.system">
    <description>Aggiornare HyleOS</description>
    <message>HyleOS deve aggiornare il sistema.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/hyleos-system-update</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
