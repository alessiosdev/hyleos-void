<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>HyleOS</vendor>
  <vendor_url>https://hyleos.org</vendor_url>

  <action id="org.hyleos.store.xbps.install">
    <description>Installare pacchetti di sistema</description>
    <message>HyleOS Store deve installare un pacchetto di sistema.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/hyleos/hyleos-store-xbps</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>

  <action id="org.hyleos.store.xbps.remove">
    <description>Rimuovere pacchetti di sistema</description>
    <message>HyleOS Store deve rimuovere un pacchetto di sistema.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/hyleos/hyleos-store-xbps</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
